{
  "name": "ROS · B · Processing batch (daily)",
  "nodes": [
    {
      "id": "processing-schedule",
      "name": "Processing schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "enqueue-processing",
      "name": "Enqueue processing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "parameters": {
        "method": "POST",
        "url": "={{$env.ROS_API_BASE_URL}}/api/internal/process",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "authorization",
              "value": "=Bearer {{$env.CRON_SECRET}}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}"
      }
    }
  ],
  "connections": {
    "Processing schedule": {
      "main": [
        [
          {
            "node": "Enqueue processing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "recruiting-os"
    }
  ]
}
